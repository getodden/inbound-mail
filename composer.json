{
    "name": "getodden/inbound-mail",
    "description": "Receive email in Laravel from Amazon SES, Mailgun, Postmark and SendGrid as one hardened message object: a sender parsed like a mail client parses it, an honest authenticated flag, delivery reports and automatic-mail detection.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "email", "inbound-email", "ses", "mailgun", "postmark", "sendgrid", "helpdesk", "bounce"],
    "homepage": "https://odden.io",
    "support": {
        "issues": "https://github.com/getodden/inbound-mail/issues",
        "source": "https://github.com/getodden/inbound-mail"
    },
    "authors": [
        {"name": "CaskStack, LLC", "homepage": "https://odden.io"}
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "zbateson/mail-mime-parser": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {"Odden\\InboundMail\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Odden\\InboundMail\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": ["Odden\\InboundMail\\InboundMailServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
